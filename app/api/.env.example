DATABASE_URL=postgresql+psycopg://dev:SuperAdmin@localhost:5432/hrms
JWT_SECRET=replace-with-a-long-random-secret
ERP_API_KEY=replace-with-a-long-random-erp-integration-secret
BOOTSTRAP_SEED_DATA=false
ORGANIZATION_NAME=My Organization
ORGANIZATION_CODE=ORG
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000
SUPER_ADMIN_EMAIL=admin@hrms.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SuperAdmin@123
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# ── Authentication: tokens and session policy ────────────────────────────────
# Defaults are production-safe; deployments may shorten them. Values here are
# the API-side truth — the BFF derives cookie lifetimes from the session that
# login returns.
ACCESS_TOKEN_TTL_SECONDS=900
PRIVILEGED_ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
PRIVILEGED_IDLE_TIMEOUT_SECONDS=900
PRIVILEGED_ABSOLUTE_TIMEOUT_SECONDS=7200

# ── Authentication: brute-force & refresh-abuse throttling ───────────────────
AUTH_THROTTLE_MAX_FAILURES=5
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_THROTTLE_BLOCK_SECONDS=60
AUTH_THROTTLE_MAX_BLOCK_SECONDS=3600
AUTH_REFRESH_MAX_FAILURES=20
# `memory` is fine for a single worker. Production requires `redis` (startup
# fails without it) so limits hold across workers — install the extra first:
#   uv sync --extra redis
AUTH_THROTTLE_BACKEND=memory
REDIS_URL=
# Only enable behind a proxy you control: any reachable client could forge
# X-Forwarded-For and escape per-IP throttling.
TRUST_PROXY_HEADERS=false

# ── Authentication: Super Admin MFA (TOTP) ───────────────────────────────────
MFA_ENABLED=true
# Set true in production: privileged sign-in is password-only until then (the
# API logs a startup warning while this is false).
MFA_REQUIRED_FOR_SUPER_ADMIN=false
MFA_ISSUER=People HRMS
MFA_CHALLENGE_TTL_SECONDS=300

# ── Password policy ──────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=256
# off | local (embedded common-password list) | remote (k-anonymity API, fails open)
PASSWORD_BREACH_CHECK=local
PASSWORD_BREACH_CHECK_URL=

# Logging (12-factor): stdout by default; file appender opt-in.
# Keep LOG_TO_FILE=false in dev — writing api.log inside the watched tree is
# what caused the infinite `watchfiles ... 1 change detected` reload loop.
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_TO_FILE=false
LOG_DIR=logs
LOG_FILE_NAME=api.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
