# People HRMS API environment reference
#
# Copy this file to `.env` for local development. Never commit `.env` or put
# real passwords, database URLs, HMAC secrets, or encryption keys in Git.
#
# DEPLOYMENT PROFILES
# - Local development: ENVIRONMENT=development, BOOTSTRAP_SEED_DATA=true is OK.
# - First production start: set every REQUIRED PRODUCTION value below, run
#   Alembic migrations, then set BOOTSTRAP_SEED_DATA=true for one start only.
# - Normal production starts: BOOTSTRAP_SEED_DATA=false. ERP owns organization
#   and employee master data after bootstrap.

# ── Application and database ────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Use the psycopg PostgreSQL URL and URL-encode special
# characters in the password.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://hrms:change-me@localhost:5432/people_hrms
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
EXPOSE_API_DOCS=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TIMEZONE=Asia/Kolkata

# Alternative database fields. They are only used when DATABASE_URL is empty.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hrms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=people_hrms

# ── One-time bootstrap ──────────────────────────────────────────────────────
# Set true for the first deployment only. It creates the initial organization
# when none exists and creates or repairs one Super Admin account. Set false
# immediately after that successful start.
BOOTSTRAP_SEED_DATA=false
ORGANIZATION_NAME=My Organization
ORGANIZATION_CODE=ORG
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=replace-with-a-strong-unique-password
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# ── ERP machine authentication ──────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Each ERP client has a unique 32+ character secret and
# only the scopes it needs. Requests send X-ERP-Client-ID, X-ERP-Timestamp,
# X-ERP-Nonce, and X-ERP-Signature; browsers never send these values.
# Keep this JSON on one line in a real environment variable or secret manager.
ERP_API_CLIENTS={"primary-erp":{"secret":"replace-with-32-or-more-random-characters","scopes":["*"]}}
ERP_SIGNATURE_MAX_AGE_SECONDS=300
# Development-only compatibility key. Leave empty in production; production
# does not accept X-API-Key authentication.
ERP_API_KEY=

# ── Sessions and token lifetimes (seconds) ──────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=900
LOGIN_EXCHANGE_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
PRIVILEGED_ACCESS_TOKEN_TTL_SECONDS=300
PRIVILEGED_IDLE_TIMEOUT_SECONDS=900
PRIVILEGED_ABSOLUTE_TIMEOUT_SECONDS=7200

# ── Login and refresh abuse protection ──────────────────────────────────────
AUTH_THROTTLE_MAX_FAILURES=5
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_THROTTLE_BLOCK_SECONDS=60
AUTH_THROTTLE_MAX_BLOCK_SECONDS=3600
AUTH_REFRESH_MAX_FAILURES=20
# Use `memory` only for local development or a single API worker. Production
# requires `redis` and a reachable Redis URL; install `uv sync --extra redis`.
AUTH_THROTTLE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# Set true only behind a reverse proxy you control and configure to strip
# untrusted forwarded headers before forwarding requests to the API.
TRUST_PROXY_HEADERS=false

# ── MFA and account recovery ────────────────────────────────────────────────
MFA_ENABLED=true
# REQUIRED IN PRODUCTION. Super Admin MFA must be enabled before startup.
MFA_REQUIRED_FOR_SUPER_ADMIN=false
MFA_ISSUER=People HRMS
MFA_CHALLENGE_TTL_SECONDS=300
MFA_PENDING_TTL_SECONDS=900
PASSWORD_RECOVERY_TTL_SECONDS=600
SENSITIVE_ACTION_MFA_MAX_AGE_SECONDS=600
# REQUIRED IN PRODUCTION. AES-256 key, base64-encoded 32 random bytes. Generate:
# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=

# ── Password policy ─────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=256
# off | local (embedded common-password list) | remote (external checker,
# fails open if unavailable)
PASSWORD_BREACH_CHECK=local
PASSWORD_BREACH_CHECK_URL=

# ── Email (optional unless sending invitations, password-reset, or alerts) ──
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_TO_FILE=false
LOG_DIR=logs
LOG_FILE_NAME=api.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
