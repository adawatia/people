DATABASE_URL=postgresql+psycopg://dev:SuperAdmin@localhost:5432/hrms
JWT_SECRET=change-this-secret
SUPER_ADMIN_EMAIL=admin@hrms.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SuperAdmin@123
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Logging (12-factor): stdout by default; file appender opt-in.
# Keep LOG_TO_FILE=false in dev — writing api.log inside the watched tree is
# what caused the infinite `watchfiles ... 1 change detected` reload loop.
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_TO_FILE=false
LOG_DIR=logs
LOG_FILE_NAME=api.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# Mail Configuration (Zoho Mail: smtppro.zoho.in for India, smtppro.zoho.com for US/Global)
MAIL_USERNAME=your-email@yourdomain.com
MAIL_PASSWORD=your_zoho_app_password_here
MAIL_FROM=your-email@yourdomain.com
MAIL_PORT=465
MAIL_SERVER=smtppro.zoho.in
MAIL_STARTTLS=False
MAIL_SSL_TLS=True
USE_CREDENTIALS=True
VALIDATE_CERTS=True