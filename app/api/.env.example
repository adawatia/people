# People HRMS API — environment reference
#
# Copy this file to `.env.local` for local development. Never commit `.env`,
# `.env.local`, or any file containing real passwords, database URLs, HMAC
# secrets, or encryption keys.
#
# ENVIRONMENT PROFILES
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT
#   ENVIRONMENT=development  — weak dev defaults accepted by the startup validator
#   BOOTSTRAP_SEED_DATA=true — OK for the first local start only
#   AUTH_THROTTLE_BACKEND=memory — single process only
#   MFA_REQUIRED_FOR_SUPER_ADMIN=false — convenience for local testing
#
# TESTING
#   ENVIRONMENT=test
#   Use a dedicated test database (conventionally named *_test).
#   Secret values still must be strong: JWT_SECRET, SUPER_ADMIN_PASSWORD,
#   MFA_ENCRYPTION_KEY, ERP_API_CLIENTS. BOOTSTRAP_SEED_DATA=true is acceptable
#   when a known seed state is intentionally wanted in the test DB.
#
# PRODUCTION
#   ENVIRONMENT=production — weak dev defaults are REJECTED at startup
#   Every secret must be replaced with a strong unique value BEFORE first start.
#   BOOTSTRAP_SEED_DATA=true ONLY for the very first production start, then false.
#   AUTH_THROTTLE_BACKEND=redis is REQUIRED for more than one worker.
#   MFA_REQUIRED_FOR_SUPER_ADMIN=true is strongly recommended.
#   Real credentials belong in a secret manager / deployment secrets, not .env files.
#
# NAMING CONVENTION USED BELOW
# ─────────────────────────────────────────────────────────────────────────────
# Database: hrms_db        (local/dev/test)
# Role:     hrms_user      (local/dev/test)
# Password: admin          (example placeholder ONLY — replace immediately)
#
# The example password below is URL-encoded because the correct pattern for a
# DATABASE_URL is to URL-encode the password. 'admin' has no special characters
# so the encoded form is still 'admin', but the pattern matters for real passwords.

# ── Application and database ──────────────────────────────────────────────────
# REQUIRED in production. The async driver is psycopg; URL-encode special
# characters in the password (e.g. ':' → '%3A', '/' → '%2F', '@' → '%40').
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://hrms_user:admin@localhost:5432/hrms_db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
EXPOSE_API_DOCS=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TIMEZONE=Asia/Kolkata

# Alternative connection fields. Used only when DATABASE_URL is empty.
# Keep these consistent with DATABASE_URL to avoid confusion.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hrms_user
POSTGRES_PASSWORD=admin
POSTGRES_DB=hrms_db

# Single-server connection budget: at most DB_POOL_SIZE + DB_MAX_OVERFLOW async
# connections, plus a couple of health-check connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# ── One-time bootstrap ─────────────────────────────────────────────────────────
# Set true for the FIRST deployment only. Creates the initial organization when
# none exists and creates or repairs ONE Super Admin account. Set false
# immediately after that successful start.
BOOTSTRAP_SEED_DATA=false
ORGANIZATION_NAME=My Organization
ORGANIZATION_CODE=ORG
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=replace-with-a-strong-unique-password
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# ── ERP machine authentication ────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Each ERP client gets a unique 32+ character secret and
# only the scopes it needs. Requests carry:
#   X-ERP-Client-ID, X-ERP-Timestamp, X-ERP-Nonce, X-ERP-Signature
# Browsers never send these — they are machine-to-machine only.
#
# Format: {"client-id": {"secret": "...", "scopes": [...]}}
# Keep this JSON on one line in a real environment variable or secret manager.
ERP_API_CLIENTS={"primary-erp": {"secret": "replace-with-32-or-more-random-characters", "scopes": ["*"]}}
ERP_SIGNATURE_MAX_AGE_SECONDS=300
# Alert when the oldest unacknowledged outbound event is older than this many
# seconds (GET /integrations/erp/sync/status -> feed.behind_schedule).
ERP_SYNC_STALE_AFTER_SECONDS=86400
# How long acknowledged outbox events are kept for audit. The API does not prune
# on its own; run the documented maintenance DELETE with the same window.
ERP_OUTBOX_RETENTION_DAYS=90

# Development-only compatibility key. Leave empty in production; production does
# not accept X-API-Key authentication.
ERP_API_KEY=

# ── Sessions and token lifetimes (seconds) ────────────────────────────────────
# Short access tokens + server-side rotating refresh sessions. Do NOT lengthen
# these to make local testing "more convenient". Short lifetimes are the reason
# a compromised token has a small window and why permissions are never cached in
# the token itself.
ACCESS_TOKEN_TTL_SECONDS=900
LOGIN_EXCHANGE_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
PRIVILEGED_ACCESS_TOKEN_TTL_SECONDS=300
PRIVILEGED_IDLE_TIMEOUT_SECONDS=900
PRIVILEGED_ABSOLUTE_TIMEOUT_SECONDS=7200

# ── Login and refresh abuse protection ────────────────────────────────────────
# Development: in-process memory store. Single worker only.
# Production: AUTH_THROTTLE_BACKEND=redis + a reachable REDIS_URL.
# Install Redis support with: uv sync --extra redis
AUTH_THROTTLE_MAX_FAILURES=5
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_THROTTLE_BLOCK_SECONDS=60
AUTH_THROTTLE_MAX_BLOCK_SECONDS=3600
AUTH_REFRESH_MAX_FAILURES=20
AUTH_THROTTLE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Set true ONLY behind a reverse proxy you control that strips untrusted
# X-Forwarded-* headers before forwarding requests to the API.
TRUST_PROXY_HEADERS=false

# ── MFA and account recovery ──────────────────────────────────────────────────
MFA_ENABLED=true
# REQUIRED IN PRODUCTION. Super Admin MFA must be enabled before startup.
MFA_REQUIRED_FOR_SUPER_ADMIN=false
MFA_ISSUER=People HRMS
MFA_CHALLENGE_TTL_SECONDS=300
MFA_PENDING_TTL_SECONDS=900
PASSWORD_RECOVERY_TTL_SECONDS=600
SENSITIVE_ACTION_MFA_MAX_AGE_SECONDS=600

# REQUIRED IN PRODUCTION. AES-256 key, base64-encoded 32 random bytes.
# Generate one with:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# An empty value resolves to the development key, which production startup refuses.
MFA_ENCRYPTION_KEY=

# ── Password policy ────────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=256
# off | local (embedded common-password list) | remote (external checker,
# fails open if unavailable)
PASSWORD_BREACH_CHECK=local
PASSWORD_BREACH_CHECK_URL=

# ── Email (optional unless sending invitations, password-reset, or alerts) ────
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_TO_FILE=false
LOG_DIR=logs
LOG_FILE_NAME=api.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# ── Local development quick values (do NOT copy these to production) ───────────
# The values below are the documented local-development defaults used by
# app/api/.env.local. They exist here as the reference point for "what database
# and role does local development use", not as a production-safe secret.
#
#   Local DB:   hrms_db
#   Local role: hrms_user
#   Local pass: admin   (placeholder — replace with a real secret before sharing)
#
# For local development, prefer copying .env.example → .env.local and editing
# .env.local. That keeps .env.example as a stable reference and .env.local as
# the file that actually changes per developer / per machine.
