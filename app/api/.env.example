# ==============================================================================
# People HRMS API — Environment Configuration Reference
# ==============================================================================
# Copy this file to `.env` (or `.env.local`) for local development.
# In production, provide these values via your deployment secrets or environment.

# ------------------------------------------------------------------------------
# 1. Application & Environment
# ------------------------------------------------------------------------------
# Environment profile: 'development' | 'production' | 'test'
ENVIRONMENT=development

# Enable interactive OpenAPI docs at /docs and /redoc ('true' | 'false')
EXPOSE_API_DOCS=true

# Frontend web application URL (used for CORS and invitation/password-reset links)
FRONTEND_URL=http://localhost:3000

# Allowed CORS origins for browser clients (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000

# Application time zone for scheduling, shifts, and timestamps
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Full PostgreSQL connection URL (async psycopg driver). Overrides individual POSTGRES_* fields below.
DATABASE_URL=postgresql+psycopg://hrms-user:Admin123@localhost:5432/hrms-db

# Individual connection fields (used only if DATABASE_URL is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hrms-user
POSTGRES_PASSWORD=Admin123
POSTGRES_DB=hrms-db

# Connection pool settings for async database operations
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key for signing JWT access and session tokens (min 32 random characters)
JWT_SECRET=dev-jwt-secret-change-in-production-32-chars

# AES-256 key for encrypting TOTP MFA seeds at rest (base64-encoded 32 random bytes)
# Generate with: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=

# Global MFA feature switch ('true' | 'false')
MFA_ENABLED=true

# Enforce mandatory second-factor authentication for Super Admin accounts ('true' | 'false')
MFA_REQUIRED_FOR_SUPER_ADMIN=false

# Authenticator app issuer display label
MFA_ISSUER=People HRMS

# MFA challenge, enrollment, and password recovery token lifetimes (in seconds)
MFA_CHALLENGE_TTL_SECONDS=300
MFA_PENDING_TTL_SECONDS=900
PASSWORD_RECOVERY_TTL_SECONDS=600
SENSITIVE_ACTION_MFA_MAX_AGE_SECONDS=600

# Password policy rules
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=256
# Breach checking: 'off' | 'local' (embedded common password list) | 'remote' (external API)
PASSWORD_BREACH_CHECK=local
PASSWORD_BREACH_CHECK_URL=

# ------------------------------------------------------------------------------
# 4. Session & Token Lifetimes (seconds)
# ------------------------------------------------------------------------------
# Workforce accounts (Employees, Managers, HR, Org Owner)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200

# Technical administrator account (Super Admin)
PRIVILEGED_ACCESS_TOKEN_TTL_SECONDS=300
PRIVILEGED_IDLE_TIMEOUT_SECONDS=900
PRIVILEGED_ABSOLUTE_TIMEOUT_SECONDS=7200

# Short-lived OAuth2 password exchange token (seconds)
LOGIN_EXCHANGE_TOKEN_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 5. Rate Limiting & Abuse Protection
# ------------------------------------------------------------------------------
# Throttle storage backend: 'memory' (single worker / dev) or 'redis' (multi-worker production)
AUTH_THROTTLE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Failed login attempt limits and progressive block windows
AUTH_THROTTLE_MAX_FAILURES=5
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_THROTTLE_BLOCK_SECONDS=60
AUTH_THROTTLE_MAX_BLOCK_SECONDS=3600
AUTH_REFRESH_MAX_FAILURES=20

# Trust X-Forwarded-For headers (only enable if behind a trusted reverse proxy)
TRUST_PROXY_HEADERS=false

# ------------------------------------------------------------------------------
# 6. Initial Bootstrap Setup
# ------------------------------------------------------------------------------
# Automatically initialize the singleton organization and Super Admin account on first start
BOOTSTRAP_SEED_DATA=false

ORGANIZATION_NAME=My Organization
ORGANIZATION_CODE=ORG

SUPER_ADMIN_EMAIL=admin@hrms.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SuperAdmin@123
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# ------------------------------------------------------------------------------
# 7. ERP Machine Integration
# ------------------------------------------------------------------------------
# JSON map of authorized ERP clients, secrets, and scopes for HMAC signed requests
ERP_API_CLIENTS={"primary-erp": {"secret": "replace-with-32-or-more-random-characters", "scopes": ["*"]}}

# Maximum allowed request clock skew and replay protection window (seconds)
ERP_SIGNATURE_MAX_AGE_SECONDS=300

# Outbound sync health and audit retention thresholds
ERP_SYNC_STALE_AFTER_SECONDS=86400
ERP_OUTBOX_RETENTION_DAYS=90

# Development-only static API key compatibility bypass (ignored in production)
ERP_API_KEY=

# ------------------------------------------------------------------------------
# 8. Email / SMTP Configuration (Optional)
# ------------------------------------------------------------------------------
MAIL_SERVER=smtppro.zoho.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true

# ------------------------------------------------------------------------------
# 9. Logging
# ------------------------------------------------------------------------------
# Log level: 'DEBUG' | 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL'
LOG_LEVEL=INFO

# Console log format: 'console' (human readable) | 'json' (structured production logs)
LOG_FORMAT=console

# Optional file appender
LOG_TO_FILE=false
LOG_DIR=logs
LOG_FILE_NAME=api.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
