# ==============================================================================
# People HRMS Web — Frontend Environment Configuration Reference
# ==============================================================================
# Copy this file to `.env` (or `.env.local`) for local development.

# URL of the upstream FastAPI backend service (used by the Nitro BFF proxy)
NUXT_HRMS_API_BASE=http://127.0.0.1:8000

# Comma-separated browser origins allowed to make cookie-authenticated requests
NUXT_HRMS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
