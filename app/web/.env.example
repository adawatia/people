# Nuxt ECharts has no environment variables.
# URL of the FastAPI HRMS service used by the server-side proxy.
NUXT_HRMS_API_BASE=http://127.0.0.1:8000
# Comma-separated browser origins allowed to make cookie-authenticated requests.
NUXT_HRMS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.103.20:3000
