  "components": [
    {
      "name": "Navigation row",
      "kind": "nav",
      "refersTo": "platform-nav",
      "description": "Default, hover and current workspace destinations.",
      "html": "<a class=\"ds-nav\" href=\"#overview\">Overview</a><a class=\"ds-nav\" href=\"#attendance\" aria-current=\"page\">Attendance</a>",
      "css": ".ds-nav{font-family:var(--font-sans);display:flex;align-items:center;gap:12px;min-height:44px;padding:10px 12px;border-radius:8px;color:var(--people-muted);font-size:14px;font-weight:500;line-height:1.4;text-decoration:none}.ds-nav:hover{background:var(--people-canvas);color:var(--people-text)}.ds-nav[aria-current=page]{background:var(--people-lavender);color:var(--people-lavender-ink);font-weight:600}.ds-nav:focus-visible{outline:2px solid var(--ui-primary);outline-offset:3px;}@media(prefers-reduced-motion:no-preference){.ds-nav{transition:background-color 160ms ease-out,color 160ms ease-out}}"
    },
    {
      "name": "Workspace selector",
      "kind": "input",
      "refersTo": "workspace-select",
      "description": "Visible only for multiple available workspaces; collapsed rail uses a dropdown. Options are illustrative and runtime availability remains permission-driven.",
      "html": "<label class=\"ds-label\" for=\"ds-workspace\">Workspace</label><select class=\"ds-select\" id=\"ds-workspace\"><option>My workspace</option><option>HR workspace</option></select>",
      "css": ".ds-label{font-family:var(--font-sans);display:block;margin-bottom:8px;font-size:12px;font-weight:600;color:var(--people-muted)}.ds-select{font-family:var(--font-sans);width:100%;min-height:44px;border:1px solid var(--people-border);border-radius:8px;background:var(--people-canvas);padding:10px 34px 10px 12px;font-size:14px;font-weight:600;color:var(--people-text);cursor:pointer}.ds-select:focus-visible{outline:2px solid var(--ui-primary);outline-offset:3px;}"
    },
    {
      "name": "Sign out",
      "kind": "button",
      "refersTo": "platform-sign-out",
      "description": "Dedicated account action. The application supplies loading, duplicate-submission prevention and error toast/retry.",
      "html": "<button class=\"ds-signout\" type=\"button\">Sign out</button>",
      "css": ".ds-signout{font-family:var(--font-sans);display:flex;align-items:center;justify-content:center;gap:8px;min-height:44px;color:var(--people-lavender-ink);background:var(--people-lavender);border:1px solid var(--people-lavender-ink);cursor:pointer}.ds-signout:hover{background:var(--people-surface)}.ds-signout:focus-visible{outline:2px solid var(--ui-primary);outline-offset:3px;}.ds-signout:disabled{cursor:default}@media(prefers-reduced-motion:no-preference){.ds-signout{transition:background-color 160ms ease-out}}"
    },
    {
      "name": "Desktop search trigger",
      "kind": "button",
      "refersTo": "platform-search",
      "description": "Desktop bordered trigger; Nuxt UI supplies its ghost-button interaction treatment.",
      "html": "<button class=\"ds-search\" type=\"button\">Search pages</button>",
      "css": ".ds-search{font-family:var(--font-sans);display:inline-flex;align-items:center;justify-content:flex-start;min-width:180px;min-height:44px;gap:10px;padding:0 12px;border:1px solid var(--people-border);border-radius:8px;background:var(--people-canvas);color:var(--people-text);font-size:13px;font-weight:400;cursor:pointer}.ds-search:focus-visible{outline:2px solid var(--ui-primary);outline-offset:3px;}"
    },
    {
      "name": "Surface card",
      "kind": "card",
      "refersTo": "people-card",
      "description": "Reusable page surface; padding belongs to its consuming page.",
      "html": "<section class=\"ds-card\">Workspace content</section>",
      "css": ".ds-card{font-family:var(--font-sans);border:1px solid var(--people-border);border-radius:12px;background:color-mix(in srgb,var(--people-surface) 96%,transparent);color:var(--people-text)}"
    },
    {
      "name": "Authentication field",
      "kind": "input",
      "refersTo": "auth-input",
      "description": "Authentication minimum sizing and semantic colors; the app retains Nuxt UI field structure and states.",
      "html": "<label class=\"ds-auth-label\" for=\"ds-email\">Email</label><input class=\"ds-auth-input\" id=\"ds-email\" autocomplete=\"email\" placeholder=\"Email\">",
      "css": ".ds-auth-label{font-family:var(--font-sans);color:var(--people-text)}.ds-auth-input{font-family:var(--font-sans);min-height:48px;background:var(--auth-paper,var(--people-canvas));color:var(--auth-ink,var(--people-text));caret-color:var(--auth-violet,var(--ui-primary))}.ds-auth-input::placeholder{color:var(--auth-muted,var(--people-muted));opacity:1}.ds-auth-input:focus-visible{outline:2px solid var(--auth-violet,var(--ui-primary));outline-offset:3px}"
    },
    {
      "name": "Authentication link",
      "kind": "button",
      "refersTo": "auth-link",
      "description": "Quiet recovery and secondary authentication navigation.",
      "html": "<a class=\"ds-auth-link\" href=\"#recovery\">Recover password</a>",
      "css": ".ds-auth-link{font-family:var(--font-sans);display:inline-flex;align-items:center;min-height:44px;color:var(--auth-violet,var(--ui-primary));font-size:14px;text-underline-offset:4px;text-decoration:none}.ds-auth-link:hover{text-decoration:underline}.ds-auth-link:focus-visible{outline:2px solid var(--auth-violet,var(--ui-primary));outline-offset:3px}"
    },
    {
      "name": "Dashboard summary cell",
      "kind": "custom",
      "refersTo": "dashboard-summary-item",
      "description": "Grouped responsive dashboard metric; preview uses unavailable data rather than invented workforce values.",
      "html": "<dl class=\"ds-summary\"><div class=\"ds-summary-cell\"><dt>Attendance</dt><dd>—</dd></div></dl>",
      "css": ".ds-summary{font-family:var(--font-sans);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border:1px solid var(--people-border);border-radius:12px;background:var(--people-surface);overflow:hidden}.ds-summary-cell{min-width:0;padding:20px}.ds-summary dt{color:var(--people-muted);font-size:12px;line-height:1.5}.ds-summary dd{margin:12px 0 0;font-size:clamp(24px,2.5vw,32px);line-height:1.15;font-weight:600;font-variant-numeric:tabular-nums;color:var(--people-text);overflow-wrap:anywhere}@media(max-width:767px){.ds-summary-cell{padding:16px}}"
    },
    {
      "name": "Dashboard panel",
      "kind": "card",
      "refersTo": "dashboard-panel",
      "description": "Flat operational panel with responsive padding.",
      "html": "<section class=\"ds-dashboard-panel\"><h2>Attendance trend</h2><p>Daily attendance composition; a text alternative follows below.</p></section>",
